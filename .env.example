# Copy to .env (loaded by charforge/config.py; real env vars win).
# Blender executable (auto-detected when empty)
BLENDER_PATH=/Applications/Blender.app/Contents/MacOS/Blender
# Project data root (default: ./projects)
CHARFORGE_HOME=
# 1 = eyes (split/render/score) | 2 = + generate/fit/optimize/export | 3 = + rig/pipeline_run
CHARFORGE_LEVEL=1
# Image-to-3D providers (L2). All empty -> generate_mesh falls back to the silhouette blockout.
TRIPO_API_KEY=
MESHY_API_KEY=
RODIN_API_KEY=
FAL_KEY=
# Visual critic (advisory): a vision model grades renders against the sheet.
# Gemini: pip install "charforge[critic]" + GEMINI_API_KEY. Claude: pip install "charforge[critic-claude]" + ANTHROPIC_API_KEY.
# auto = on when an SDK and its key exist | on | off
CHARFORGE_CRITIC=auto
# auto = Gemini first, then Claude | gemini | claude
CHARFORGE_CRITIC_BACKEND=auto
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
